+/// Synthetic telemetry bootstrap; later simulated events are handled by MockKit.
+/// This is not a YpsoPump hardware driver or a complete PumpManager implementation.
+enum YpsoTrioSimulatorBridge {
+    static func configure(_ manager: MockPumpManager) throws {
+        let status = try SimulationScenario.normal.parsedStatus()
+        var state = manager.state
+        state.reservoirUnitsRemaining = status.reservoirUnits
+        state.pumpBatteryChargeRemaining = status.batteryBars.map { Double($0) / 5 }
+        state.suspendState = .suspended(Date())
+        state.bolusEnactmentShouldError = true
+        state.tempBasalEnactmentShouldError = true
+        manager.state = state
+    }
