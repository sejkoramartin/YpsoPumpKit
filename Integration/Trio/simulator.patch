+struct YpsoAdvertisementSearchView: View {
+    @StateObject private var scanner = YpsoAdvertisementSearch()
+    @Environment(\.scenePhase) private var scenePhase
+
+    var body: some View {
+        List {
+            Section {
+                Text("Diagnostika reklam BLE — bez připojení a párování")
+                    .font(.headline)
+                Text("iOS může při hledání vysílat dotazy na reklamní údaje. Nejde o zaručeně pasivní poslech. CamAPS nech běžet; pumpu nepřepínej do párování.")
+                Text("Při výpadku spojení CamAPS hledání zastav. Nalezený název nepotvrzuje identitu pumpy.")
+                    .foregroundStyle(.orange)
+                Button("Spustit hledání na 30 sekund") { scanner.start() }
+                    .disabled(scanner.active)
+                Button("Stop", role: .destructive) { scanner.stop() }
+                    .disabled(!scanner.active)
+                Text(scanner.status)
+            }
+            Section("Zachycená zařízení: \(scanner.results.count)") {
+                ForEach(scanner.results) { result in
+                    VStack(alignment: .leading) {
+                        Text(result.name)
+                        Text("ID v iOS: " + result.id.uuidString)
+                            .font(.caption.monospaced())
+                        Text("Název je poslední zachycený v tomto hledání; ID není Bluetooth MAC adresa.")
+                            .font(.caption).foregroundStyle(.secondary)
+                        if result.candidate {
+                            Text("Možná YpsoPump — neověřená identita")
+                                .foregroundStyle(.orange)
+                        }
+                        Text(result.rssi == 127 ? "Síla signálu není dostupná" : "Signál: \(result.rssi) dBm")
+                            .font(.caption)
+                        Text("Poslední hlášení: \(result.lastSeen.formatted(date: .omitted, time: .standard)) · Počet: \(result.reports)")
+                            .font(.caption)
+                        DisclosureGroup("Podrobnosti posledního hlášení") {
+                            if result.details.isEmpty {
+                                Text("iOS v tomto hlášení neposkytl služby ani další diagnostické údaje.")
+                            }
+                            ForEach(Array(result.details.enumerated()), id: \.offset) { _, detail in
+                                Text(detail).font(.caption.monospaced()).textSelection(.enabled)
+                            }
+                        }
+                    }
+                }
+            }
+            Section {
+                Text("Výrobní a servisní údaje mohou obsahovat identifikátory zařízení; snímky nesdílej veřejně. Výsledky se neukládají ani neodesílají. Tento seznam nepřidává skutečnou pumpu do Tria. Léčebný adaptér zůstává simulovaný.")
+            }
+        }
+        .navigationTitle("Hledání YpsoPump")
+        .onDisappear { scanner.stop() }
+        .onChange(of: scenePhase) { _, phase in
+            if phase != .active { scanner.stop("Hledání zastaveno při opuštění aplikace.") }
+        }
+    }
+}
