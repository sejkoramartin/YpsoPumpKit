+@Suite("Ypso offline services") struct YpsoTrioOfflineTests {
+    @Test func bluetoothProviderNeverAuthorizesHardware() {
+        let provider = BaseBluetoothStateManager(resolver: Container())
+        #expect(provider.bluetoothAuthorization == .denied)
+        #expect(provider.bluetoothState == .poweredOff)
+        var completed = false
+        provider.authorizeBluetooth { authorization in
+            #expect(authorization == .denied)
+            completed = true
+        }
+        #expect(completed)
+    }
+
+    @Test func mockRejectsDeliveryCommands() throws {
+        let mock = MockPumpManager()
+        try YpsoTrioSimulatorBridge.configure(mock)
+        var basalRejected = false
+        mock.enactTempBasal(unitsPerHour: 1, for: 60) { error in
+            basalRejected = error != nil
+        }
+        #expect(basalRejected)
+        var bolusRejected = false
+        mock.enactBolus(units: 1, activationType: .manualNoRecommendation) { error in
+            bolusRejected = error != nil
+        }
+        #expect(bolusRejected)
+        #expect(YpsoTrioSimulationPolicy.isEnabled)
+    }
