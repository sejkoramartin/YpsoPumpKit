+// Diagnostic-only central; intentionally unrelated to Trio's pump transport.
+// Results are advertisements, never authenticated pump identities.
+final class YpsoAdvertisementSearch: NSObject, ObservableObject, CBCentralManagerDelegate {
+    struct Result: Identifiable {
+        let id: UUID
+        let name: String
+        let rssi: Int
+        let candidate: Bool
+        let lastSeen: Date
+        let reports: Int
+        let details: [String]
+
+        static func hex(_ data: Data) -> String {
+            let text = data.prefix(96).map { String(format: "%02X", $0) }.joined(separator: " ")
+            return data.count > 96 ? text + " … (\(data.count) B celkem)" : text
+        }
+
+        init(id: UUID, advertisement: [String: Any], rssi: Int, now: Date, previous: Result? = nil) {
+            self.id = id
+            name = advertisement[CBAdvertisementDataLocalNameKey] as? String ?? previous?.name ?? "Bez reklamního názvu"
+            self.rssi = rssi
+            candidate = YpsoAdvertisementSearch.isCandidate(name)
+            lastSeen = now
+            reports = (previous?.reports ?? 0) + 1
+            var fields: [String] = []
+            for (key, label) in [(CBAdvertisementDataServiceUUIDsKey, "Služby"),
+                                 (CBAdvertisementDataOverflowServiceUUIDsKey, "Další služby"),
+                                 (CBAdvertisementDataSolicitedServiceUUIDsKey, "Požadované služby")] {
+                if let values = advertisement[key] as? [CBUUID], !values.isEmpty {
+                    fields.append(label + ": " + values.map { $0.uuidString }.sorted().joined(separator: ", "))
+                }
+            }
+            if let data = advertisement[CBAdvertisementDataManufacturerDataKey] as? Data {
+                if data.count >= 2 {
+                    let bytes = Array(data.prefix(2))
+                    let company = UInt16(bytes[0]) | UInt16(bytes[1]) << 8
+                    fields.append(String(format: "ID výrobce: 0x%04X (neověřuje typ zařízení)", company))
+                }
+                fields.append("Výrobní data: " + Self.hex(data))
+            }
+            if let data = advertisement[CBAdvertisementDataServiceDataKey] as? [CBUUID: Data] {
+                for key in data.keys.sorted(by: { $0.uuidString < $1.uuidString }) {
+                    if let value = data[key] {
+                        fields.append("Data služby " + key.uuidString + ": " + Self.hex(value))
+                    }
+                }
+            }
+            if let connectable = advertisement[CBAdvertisementDataIsConnectable] as? NSNumber {
+                fields.append("Reklama připouští spojení: " + (connectable.boolValue ? "ano" : "ne") + " — nepřipojujeme se")
+            }
+            if let power = advertisement[CBAdvertisementDataTxPowerLevelKey] as? NSNumber {
+                fields.append("Deklarovaný vysílací výkon: \(power.intValue) dBm")
+            }
+            details = fields
+        }
+    }
+
+    @Published private(set) var results: [Result] = []
+    @Published private(set) var active = false
+    @Published private(set) var status = "Hledání není spuštěné."
+    private var central: CBCentralManager?
+    private var deadline: Timer?
+
+    static func isCandidate(_ name: String) -> Bool {
+        name.range(of: #"^(YpsoPump_|mylife YpsoPump )10[0-9]{6}\z"#,
+                   options: .regularExpression) != nil
+    }
+
+    func start() {
+        guard !active else { return }
+        results = []
+        active = true
+        status = "Čekám na Bluetooth oprávnění a zapnutí rádia…"
+        deadline = Timer.scheduledTimer(withTimeInterval: 30, repeats: false) { [weak self] _ in
+            self?.stop("Čas hledání vypršel. Nenalezení názvu nevylučuje přítomnost pumpy.")
+        }
+        if let central = central {
+            centralManagerDidUpdateState(central)
+        } else {
+            // Created only after the user taps Start, never on screen appearance.
+            central = CBCentralManager(delegate: self, queue: .main,
+                                       options: [CBCentralManagerOptionShowPowerAlertKey: false])
+        }
+    }
+
+    func stop(_ message: String = "Hledání zastaveno.") {
+        central?.stopScan()
+        deadline?.invalidate()
+        deadline = nil
+        active = false
+        status = message
+    }
+
+    func centralManagerDidUpdateState(_ central: CBCentralManager) {
+        guard active else { return }
+        switch central.state {
+        case .poweredOn:
+            guard !central.isScanning else { return }
+            central.scanForPeripherals(withServices: nil,
+                                       options: [CBCentralManagerScanOptionAllowDuplicatesKey: true])
+            status = "Hledám reklamy BLE zařízení, nejvýše 30 sekund…"
+        case .unauthorized:
+            stop("Bluetooth není povolený. Oprávnění lze změnit v nastavení iOS.")
+        case .poweredOff:
+            stop("Bluetooth je vypnutý. Hledání můžeš znovu spustit po jeho zapnutí.")
+        case .unsupported:
+            stop("Toto zařízení nepodporuje BLE hledání.")
+        case .resetting:
+            stop("Bluetooth se restartuje. Hledání bylo ukončeno.")
+        case .unknown:
+            break // The same deadline also bounds waiting for authorization.
+        @unknown default:
+            stop("Neznámý stav Bluetooth; hledání ukončeno.")
+        }
+    }
+
+    func centralManager(_ central: CBCentralManager, didDiscover peripheral: CBPeripheral,
+                        advertisementData: [String: Any], rssi RSSI: NSNumber) {
+        guard active, central.isScanning else { return }
+        // Do not fall back to cached peripheral.name or retain the CBPeripheral.
+        let previous = results.first { $0.id == peripheral.identifier }
+        let result = Result(id: peripheral.identifier, advertisement: advertisementData,
+                            rssi: RSSI.intValue, now: Date(), previous: previous)
+        if let index = results.firstIndex(where: { $0.id == result.id }) {
+            results[index] = result
+        } else if results.count < 100 {
+            results.append(result)
+        }
+        results.sort {
+            if $0.candidate != $1.candidate { return $0.candidate }
+            return $0.name.localizedStandardCompare($1.name) == .orderedAscending
+        }
+    }
+
+    deinit {
+        deadline?.invalidate()
+        central?.stopScan()
+    }
+}
