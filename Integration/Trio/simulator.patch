+@Suite("Ypso simulator isolation") struct YpsoTrioIsolationTests {
+    @Test func unnamedAdvertisementExposesDetailsWithoutIdentifyingPump() {
+        let id = UUID()
+        let stamp = Date(timeIntervalSince1970: 100)
+        let value = YpsoAdvertisementSearch.Result(id: id, advertisement: [
+            CBAdvertisementDataServiceUUIDsKey: [CBUUID(string: "180A")],
+            CBAdvertisementDataManufacturerDataKey: Data([0x34, 0x12, 0xAB]),
+            CBAdvertisementDataServiceDataKey: [CBUUID(string: "180F"): Data([0x64])],
+            CBAdvertisementDataIsConnectable: NSNumber(value: true)
+        ], rssi: -60, now: stamp)
+        #expect(!value.candidate)
+        #expect(value.name == "Bez reklamního názvu")
+        #expect(value.details.contains { $0.contains("0x1234") })
+        #expect(value.details.contains { $0.contains("180A") })
+        #expect(value.details.contains { $0.contains("180F: 64") })
+        #expect(value.lastSeen == stamp)
+        #expect(value.reports == 1)
+    }
+
+    @Test func repeatedAdvertisementUpdatesFreshnessWithoutInventingFields() {
+        let id = UUID()
+        let first = YpsoAdvertisementSearch.Result(id: id, advertisement: [
+            CBAdvertisementDataLocalNameKey: "YpsoPump_10123456",
+            CBAdvertisementDataManufacturerDataKey: Data([0x01])
+        ], rssi: -90, now: Date(timeIntervalSince1970: 1))
+        #expect(!first.details.contains { $0.hasPrefix("ID výrobce:") })
+        let next = YpsoAdvertisementSearch.Result(id: id, advertisement: [:], rssi: 127,
+                                                 now: Date(timeIntervalSince1970: 2), previous: first)
+        #expect(next.id == id)
+        #expect(next.name == first.name)
+        #expect(next.candidate)
+        #expect(next.rssi == 127)
+        #expect(next.lastSeen > first.lastSeen)
+        #expect(next.reports == 2)
+        #expect(next.details.isEmpty)
+        #expect(YpsoAdvertisementSearch.Result.hex(Data(repeating: 0xFF, count: 97)).contains("97 B"))
+    }
+
+    @Test func advertisementNamesAreOnlyCandidates() {
+        #expect(YpsoAdvertisementSearch.isCandidate("YpsoPump_10123456"))
+        #expect(YpsoAdvertisementSearch.isCandidate("mylife YpsoPump 10123456"))
+        for name in ["", "YpsoPump", "OtherYpsoPump_10123456", "YpsoPump_101234567", "YpsoPump_10123456\\n"] {
+            #expect(!YpsoAdvertisementSearch.isCandidate(name))
+        }
+    }
+    @Test @MainActor func diagnosticDoesNotStartAutomatically() {
+        let search = YpsoAdvertisementSearch()
+        #expect(!search.active)
+        #expect(search.results.isEmpty)
+        search.stop()
+        search.stop()
+        #expect(!search.active)
+    }
+
+    @Test func onlySimulatorCanBeSelectedOrRestored() {
+        #expect(DeviceCatalog.pumps.count == 1)
+        #expect(DeviceCatalog.pumps.first?.manufacturer == .simulator)
+        #expect(DeviceCatalog.onboardingPumps == DeviceCatalog.pumps)
+        for identifier in ["Omnipod", "Omnipod-DASH", "Minimed500", "Dana", "YpsoPump"] {
+            #expect(DeviceCatalog.pumpEntry(forPersistedIdentifier: identifier) == nil)
+        }
+        #expect(DeviceCatalog.cgmManagerEntries.isEmpty)
+    }
+
+    @Test func syntheticStatusIsLoadedAndDosingFailsClosed() throws {
+        let mock = MockPumpManager()
+        try YpsoTrioSimulatorBridge.configure(mock)
+        #expect(abs(mock.state.reservoirUnitsRemaining - 123.45) < 0.001)
+        #expect(mock.state.pumpBatteryChargeRemaining == 0.8)
+        #expect(mock.state.bolusEnactmentShouldError)
+        #expect(mock.state.tempBasalEnactmentShouldError)
+        if case .suspended = mock.state.suspendState {} else {
+            Issue.record("Simulator must start suspended")
+        }
+    }
+}
