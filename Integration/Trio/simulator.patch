+@Suite("Ypso simulator isolation") struct YpsoTrioIsolationTests {
+    @Test func onlySimulatorCanBeSelectedOrRestored() {
+        #expect(DeviceCatalog.pumps.count == 1)
+        #expect(DeviceCatalog.pumps.first?.manufacturer == .simulator)
+        #expect(DeviceCatalog.onboardingPumps == DeviceCatalog.pumps)
+        for identifier in ["Omnipod", "Omnipod-DASH", "Minimed500", "Dana", "YpsoPump"] {
+            #expect(DeviceCatalog.pumpEntry(forPersistedIdentifier: identifier) == nil)
+        }
+        #expect(DeviceCatalog.cgmManagerEntries.isEmpty)
+    }
+
+    @Test func syntheticStatusIsLoadedAndDosingFailsClosed() throws {
+        let mock = MockPumpManager()
+        try YpsoTrioSimulatorBridge.configure(mock)
+        #expect(abs(mock.state.reservoirUnitsRemaining - 123.45) < 0.001)
+        #expect(mock.state.pumpBatteryChargeRemaining == 0.8)
+        #expect(mock.state.bolusEnactmentShouldError)
+        #expect(mock.state.tempBasalEnactmentShouldError)
+        if case .suspended = mock.state.suspendState {} else {
+            Issue.record("Simulator must start suspended")
+        }
+    }
+}
