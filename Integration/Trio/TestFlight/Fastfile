require 'json'
require 'xcodeproj'
default_platform(:ios)
platform :ios do
  lane :simulator_testflight do
    team = ENV.fetch('APPLE_TEAM_ID')
    UI.user_error!('Invalid team') unless team.match?(/\A[A-Z0-9]{10}\z/)
    bundle = "org.ypsopumpkit.#{team}.trio.sim"
    checkout = ENV.fetch('TRIO_CHECKOUT')
    mapping = JSON.parse(File.read("#{ENV.fetch('RUNNER_TEMP')}/ypso-signing/profiles.json"))
    targets = {'Trio' => '', 'Trio Watch App' => '.watchkitapp',
               'Trio Watch Complication Extension' => '.watchkitapp.TrioWatchComplication',
               'LiveActivityExtension' => '.LiveActivity'}
    UI.user_error!('Unexpected profile mapping') unless mapping.keys.sort == targets.values.map { |s| bundle+s }.sort
    project = Xcodeproj::Project.open("#{checkout}/Trio.xcodeproj")
    targets.each do |name, suffix|
      target = project.targets.find { |t| t.name == name }
      UI.user_error!("Missing target #{name}") unless target
      target.build_configurations.each do |config|
        config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
        config.build_settings['CODE_SIGN_IDENTITY'] = 'Apple Distribution'
        config.build_settings['DEVELOPMENT_TEAM'] = team
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = mapping.fetch(bundle+suffix)
      end
    end
    project.save
    api = app_store_connect_api_key(key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'), key_content: ENV.fetch('ASC_PRIVATE_KEY'))
    build = latest_testflight_build_number(api_key: api, app_identifier: bundle, initial_build_number: 0) + 1
    increment_build_number(xcodeproj: "#{checkout}/Trio.xcodeproj", build_number: build)
    build_app(workspace: "#{checkout}/Trio.xcworkspace", scheme: 'Trio', configuration: 'Release',
      destination: 'generic/platform=iOS', export_method: 'app-store',
      output_directory: "#{ENV.fetch('RUNNER_TEMP')}/ypso-output", output_name: 'YpsoTrioSIM.ipa',
      export_options: {signingStyle: 'manual', teamID: team, provisioningProfiles: mapping},
      xcargs: '-skipPackagePluginValidation -skipMacroValidation',
      buildlog_path: "#{ENV.fetch('RUNNER_TEMP')}/ypso-buildlog")
    upload_to_testflight(api_key: api, app_identifier: bundle,
      ipa: "#{ENV.fetch('RUNNER_TEMP')}/ypso-output/YpsoTrioSIM.ipa",
      skip_submission: true, distribute_external: false, skip_waiting_for_build_processing: true)
  end
end
